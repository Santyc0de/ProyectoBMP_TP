static imagen_bmp_t* clonar_estructura(const imagen_bmp_t* orig, int nuevo_alto, int nuevo_ancho) {
    imagen_bmp_t* nueva = (imagen_bmp_t*)malloc(sizeof(imagen_bmp_t));
    if (!nueva) return NULL;

    nueva->header = orig->header;
    nueva->info = orig->info;

    // Actualizamos las dimensiones y el tamaño de la cabecera e imagen
    nueva->info.ancho = nuevo_ancho;
    nueva->info.alto = nuevo_alto;

    int padding = (4 - (nuevo_ancho * 3) % 4) % 4;
    unsigned int tamFilaConPadding = (nuevo_ancho * 3) + padding;
    unsigned int tamImagen = tamFilaConPadding * nuevo_alto;

    nueva->info.tam_imagen = tamImagen;
    nueva->header.offset_datos = sizeof(cabecera_archivo_t) + sizeof(cabecera_info_t);
    nueva->header.tam_archivo = nueva->header.offset_datos + tamImagen;

    nueva->pixeles = crear_matriz(nuevo_alto, nuevo_ancho);
    if (!nueva->pixeles) {
        free(nueva);
        return NULL;
    }

    return nueva;
}

static unsigned char clampa(int valor) {
    if (valor < 0) return 0;
    if (valor > 255) return 255;
    return (unsigned char)valor;
}

typedef void (*t_transformador_pixel)(const pixel_t* src, pixel_t* dest);

static imagen_bmp_t* aplicar_filtro_pixel_a_pixel(const imagen_bmp_t* orig, t_transformador_pixel transformador) {
    int alto = abs(orig->info.alto);
    int ancho = orig->info.ancho;

    imagen_bmp_t* res = clonar_estructura(orig, alto, ancho);
    if (!res) return NULL;

    for (int i = 0; i < alto; i++) {
        for (int j = 0; j < ancho; j++) {
            transformador(&orig->pixeles[i][j], &res->pixeles[i][j]);
        }
    }
    return res;
}

static void pixel_negativo(const pixel_t* src, pixel_t* dest) {
    dest->azul = 255 - src->azul;
    dest->verde = 255 - src->verde;
    dest->rojo = 255 - src->rojo;
}

static void pixel_escala_grises(const pixel_t* src, pixel_t* dest) {
    int gris = (int)(0.114f * src->azul + 0.587f * src->verde + 0.299f * src->rojo);
    unsigned char g = clampa(gris);
    dest->azul = g;
    dest->verde = g;
    dest->rojo = g;
}

imagen_bmp_t* aplicar_negativo(const imagen_bmp_t* orig) {
    return aplicar_filtro_pixel_a_pixel(orig, pixel_negativo);
}

imagen_bmp_t* aplicar_escala_grises(const imagen_bmp_t* orig) {
    return aplicar_filtro_pixel_a_pixel(orig, pixel_escala_grises);
}

imagen_bmp_t* aplicar_tonalidad(const imagen_bmp_t* orig, char canal, int porcentaje) {
    int alto = abs(orig->info.alto);
    int ancho = orig->info.ancho;

    imagen_bmp_t* res = clonar_estructura(orig, alto, ancho);
    if (!res) return NULL;

    float factor = 1.0f + (porcentaje / 100.0f);

    for (int i = 0; i < alto; i++) {
        for (int j = 0; j < ancho; j++) {
            res->pixeles[i][j] = orig->pixeles[i][j];
            if (canal == 'b' || canal == 'B') res->pixeles[i][j].azul = clampa((int)(orig->pixeles[i][j].azul * factor));
            if (canal == 'g' || canal == 'G') res->pixeles[i][j].verde = clampa((int)(orig->pixeles[i][j].verde * factor));
            if (canal == 'r' || canal == 'R') res->pixeles[i][j].rojo = clampa((int)(orig->pixeles[i][j].rojo * factor));
        }
    }
    return res;
}

imagen_bmp_t* aplicar_contraste(const imagen_bmp_t* orig, int porcentaje, int aumentar) {
    int alto = abs(orig->info.alto);
    int ancho = orig->info.ancho;

    imagen_bmp_t* res = clonar_estructura(orig, alto, ancho);
    if (!res) return NULL;

    float factor;
    if (aumentar) {
        if (porcentaje >= 259) porcentaje = 258;
        factor = (259.0f * (porcentaje + 255.0f)) / (255.0f * (259.0f - porcentaje));
    } else {
        factor = 1.0f - (porcentaje / 100.0f);
    }

    for (int i = 0; i < alto; i++) {
        for (int j = 0; j < ancho; j++) {
            res->pixeles[i][j].azul = clampa((int)(factor * (orig->pixeles[i][j].azul - 128) + 128));
            res->pixeles[i][j].verde = clampa((int)(factor * (orig->pixeles[i][j].verde - 128) + 128));
            res->pixeles[i][j].rojo = clampa((int)(factor * (orig->pixeles[i][j].rojo - 128) + 128));
        }
    }
    return res;
}

typedef void (*t_mapeador_coordenadas)(int i, int j, int alto, int ancho, int* src_i, int* src_j);

static imagen_bmp_t* aplicar_transformacion_geometrica(const imagen_bmp_t* orig, int nuevo_alto, int nuevo_ancho, t_mapeador_coordenadas mapear) {
    imagen_bmp_t* res = clonar_estructura(orig, nuevo_alto, nuevo_ancho);
    if (!res) return NULL;

    int orig_alto = abs(orig->info.alto);
    int orig_ancho = orig->info.ancho;

    for (int i = 0; i < nuevo_alto; i++) {
        for (int j = 0; j < nuevo_ancho; j++) {
            int src_i, src_j;
            mapear(i, j, orig_alto, orig_ancho, &src_i, &src_j);
            res->pixeles[i][j] = orig->pixeles[src_i][src_j];
        }
    }
    return res;
}

static void map_espejar_h(int i, int j, int alto, int ancho, int* src_i, int* src_j) {
    *src_i = i;
    *src_j = ancho - 1 - j;
}

static void map_espejar_v(int i, int j, int alto, int ancho, int* src_i, int* src_j) {
    *src_i = alto - 1 - i;
    *src_j = j;
}

imagen_bmp_t* aplicar_espejar_horizontal(const imagen_bmp_t* orig) {
    return aplicar_transformacion_geometrica(orig, abs(orig->info.alto), orig->info.ancho, map_espejar_h);
}

imagen_bmp_t* aplicar_espejar_vertical(const imagen_bmp_t* orig) {
    return aplicar_transformacion_geometrica(orig, abs(orig->info.alto), orig->info.ancho, map_espejar_v);
}

imagen_bmp_t* aplicar_rotar(const imagen_bmp_t* orig, int sentido_horario) {
    int orig_alto = abs(orig->info.alto);
    int orig_ancho = orig->info.ancho;

    imagen_bmp_t* res = clonar_estructura(orig, orig_ancho, orig_alto);
    if (!res) return NULL;

    for (int i = 0; i < orig_alto; i++) {
        for (int j = 0; j < orig_ancho; j++) {
            if (sentido_horario) {
                res->pixeles[j][orig_alto - 1 - i] = orig->pixeles[i][j];
            } else {
                res->pixeles[orig_ancho - 1 - j][i] = orig->pixeles[i][j];
            }
        }
    }
    return res;
}

imagen_bmp_t* aplicar_recortar(const imagen_bmp_t* orig, int porcentaje) {
    int orig_alto = abs(orig->info.alto);
    int orig_ancho = orig->info.ancho;

    int nuevo_ancho = (orig_ancho * porcentaje) / 100;
    int nuevo_alto = (orig_alto * porcentaje) / 100;
    if (nuevo_ancho < 1) nuevo_ancho = 1;
    if (nuevo_alto < 1) nuevo_alto = 1;

    imagen_bmp_t* res = clonar_estructura(orig, nuevo_alto, nuevo_ancho);
    if (!res) return NULL;

    int offset_x = (orig_ancho - nuevo_ancho) / 2;
    int offset_y = (orig_alto - nuevo_alto) / 2;

    for (int i = 0; i < nuevo_alto; i++) {
        for (int j = 0; j < nuevo_ancho; j++) {
            res->pixeles[i][j] = orig->pixeles[i + offset_y][j + offset_x];
        }
    }
    return res;
}

imagen_bmp_t* aplicar_achicar(const imagen_bmp_t* orig, int porcentaje) {
    int orig_alto = abs(orig->info.alto);
    int orig_ancho = orig->info.ancho;

    int nuevo_ancho = (orig_ancho * porcentaje) / 100;
    int nuevo_alto = (orig_alto * porcentaje) / 100;
    if (nuevo_ancho < 1) nuevo_ancho = 1;
    if (nuevo_alto < 1) nuevo_alto = 1;

    imagen_bmp_t* res = clonar_estructura(orig, nuevo_alto, nuevo_ancho);
    if (!res) return NULL;

    for (int i = 0; i < nuevo_alto; i++) {
        for (int j = 0; j < nuevo_ancho; j++) {
            int src_i = (i * orig_alto) / nuevo_alto;
            int src_j = (j * orig_ancho) / nuevo_ancho;
            res->pixeles[i][j] = orig->pixeles[src_i][src_j];
        }
    }
    return res;
}

imagen_bmp_t* aplicar_concatenar(const imagen_bmp_t* img1, const imagen_bmp_t* img2, int vertical, pixel_t color_relleno) {
    int alto1 = abs(img1->info.alto);
    int ancho1 = img1->info.ancho;
    int alto2 = abs(img2->info.alto);
    int ancho2 = img2->info.ancho;

    int alto_res, ancho_res;

    if (vertical) {
        ancho_res = (ancho1 > ancho2) ? ancho1 : ancho2;
        alto_res = alto1 + alto2;
    } else {
        ancho_res = ancho1 + ancho2;
        alto_res = (alto1 > alto2) ? alto1 : alto2;
    }

    imagen_bmp_t* res = clonar_estructura(img1, alto_res, ancho_res);
    if (!res) return NULL;

    for (int i = 0; i < alto_res; i++) {
        for (int j = 0; j < ancho_res; j++) {
            res->pixeles[i][j] = color_relleno;
        }
    }

    for (int i = 0; i < alto1; i++) {
        for (int j = 0; j < ancho1; j++) {
            res->pixeles[i][j] = img1->pixeles[i][j];
        }
    }

    if (vertical) {
        for (int i = 0; i < alto2; i++) {
            for (int j = 0; j < ancho2; j++) {
                res->pixeles[i + alto1][j] = img2->pixeles[i][j];
            }
        }
    } else {
        for (int i = 0; i < alto2; i++) {
            for (int j = 0; j < ancho2; j++) {
                res->pixeles[i][j + ancho1] = img2->pixeles[i][j];
            }
        }
    }

    return res;
}

imagen_bmp_t* aplicar_comodin(const imagen_bmp_t* orig) {
    int alto = abs(orig->info.alto);
    int ancho = orig->info.ancho;

    imagen_bmp_t* res = clonar_estructura(orig, alto, ancho);
    if (!res) return NULL;

    for (int i = 0; i < alto; i++) {
        for (int j = 0; j < ancho; j++) {
            int r = orig->pixeles[i][j].rojo;
            int g = orig->pixeles[i][j].verde;
            int b = orig->pixeles[i][j].azul;

            res->pixeles[i][j].rojo = clampa((int)(r * 0.393f + g * 0.769f + b * 0.189f));
            res->pixeles[i][j].verde = clampa((int)(r * 0.349f + g * 0.686f + b * 0.168f));
            res->pixeles[i][j].azul = clampa((int)(r * 0.272f + g * 0.534f + b * 0.131f));
        }
    }
    return res;
}
